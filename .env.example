# Database
DATABASE_URL=postgresql://rk_user:rk_password@localhost:5432/rk_pms_db

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Uploads
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# Email (SMTP)
# Leave SMTP_HOST blank to run in local-dev mode: emails are logged to the
# console instead of actually being sent (no mail server needed to test
# registration, password reset, booking, and maintenance emails locally).
# Set these to enable real delivery, e.g. via Gmail SMTP, SendGrid, or Mailtrap.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=RK Residency Hub <no-reply@rkresidencyhub.example>
SMTP_USE_TLS=true

# Used to build links inside emails (e.g. the password reset link).
# Should match wherever the frontend is actually running.
FRONTEND_BASE_URL=http://localhost:5173
